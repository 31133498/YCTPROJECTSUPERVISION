# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# On Vercel, set these in Project Settings -> Environment Variables for BOTH
# the Preview and Production environments.
# ---------------------------------------------------------------------------

# --- Firebase client SDK (PUBLIC) ------------------------------------------
# Safe to expose in the browser bundle. These identify the project; they are
# NOT secrets. Access is controlled by Firebase Security Rules, not by hiding
# these values. From: Firebase console -> Project settings -> General ->
# "Your apps" -> SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER-ONLY, SECRET) ----------------------------
# The FULL service-account JSON, on one line. NEVER prefix with NEXT_PUBLIC.
# Used by route handlers / server actions for session-cookie verification and
# custom-claims management. From: Firebase console -> Project settings ->
# Service accounts -> "Generate new private key".
# Paste the file's contents as a single-quoted one-liner, e.g.
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ... }'
FIREBASE_SERVICE_ACCOUNT_KEY=
